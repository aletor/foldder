# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# API usage log (local)
/data/api-usage.jsonl

# Spaces JSON store (local fallback / migration input; DynamoDB is production source of truth)
/data/spaces-db*.json

# Presenter share DB (local tokens + payloads)
/data/presenter-shares.json
/data/populate-shares.json
/data/loop-shares.json
/data/datasets/

# Inspiration library (local fallback store; S3 is production source of truth)
/data/inspiration-library/

# portable Node bundle (no subir)
.node-portable/

# Logo benchmark golden set (PDFs de clientes) + cache de visión
/golden-set/
/vision-cache/

# Logo intake persistencia local (fallback DynamoDB)
/data/brand-kit-brand-logo/
/data/logo-intake-events.jsonl
/data/logo-intake-batches/

# Scripts / diagnóstico local
/tmp/
/benchmark-runs/
/fixtures/page-vision-pass/runs/
/public/fixtures/page-vision-pass/runs/
/fixtures/brandkit/*.pdf
/data/published-sites/
